    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "SetMenu": {
        "displayName": "Set menu",
        "defaultPosition": "left",
        "defaultPriority": 50
      }
    }
  }
}
